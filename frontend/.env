# URLs publiques (pas de secret ici -- ce fichier finit dans le bundle JS,
# visible par n'importe qui dans les outils de dev du navigateur).

# Kong reste le point d'entrée unique -- y compris pour Keycloak désormais
# (voir kong/kong.yml, routes "/realms" et "/resources"). Une seule et même
# adresse pour tout ce qui vient du navigateur : plus besoin de toucher au
# fichier hosts de la machine.
VITE_KONG_BASE_URL=http://localhost:8000
VITE_KEYCLOAK_URL=http://localhost:8000
VITE_KEYCLOAK_REALM=infra-demo
VITE_KEYCLOAK_CLIENT_ID=infra-api
